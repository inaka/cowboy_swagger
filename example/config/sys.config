[
    {example, [
        {http_port, 8080},
        {bearer_token, ~"example-token"}
    ]},
    {cowboy_swagger, [
        {static_files, "priv/swagger"},
        {global_spec, #{
            openapi => ~"3.0.0",
            info => #{title => ~"Example API", version => ~"1.0.0"},
            components => #{
                ~"securitySchemes" => #{
                    ~"bearerAuth" => #{
                        type => http,
                        scheme => bearer,
                        description => ~"Enter example-token in the Authorize dialog."
                    }
                }
            }
        }}
    ]}
].
